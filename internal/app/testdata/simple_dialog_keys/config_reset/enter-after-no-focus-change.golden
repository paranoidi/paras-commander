== open ==
focus=nerdfont nerd=true zoom=true stacked=false mouse=false mode=edge bar=thumb format=2 split=[<<22%|<44%|*] cursors=[5|4|1] msg=""
== F8 ==
reset-confirm focus=0
== Right ==
reset-confirm focus=1
== Left ==
reset-confirm focus=0
== Enter ==
focus=nerdfont nerd=true zoom=true stacked=false mouse=false mode=edge bar=thumb format=2 split=[<<22%|<44%|*] cursors=[5|4|1] msg="Configuration reset to defaults"
