# Shared look for every docs tape. Source this first.
Set Shell bash
Set FontFamily "FiraCode Nerd Font Mono"
Set FontSize 22
Set Width 1920
Set Height 1080
Set Padding 20
Set Framerate 15
Set TypingSpeed 40ms
# Colours from the maintainer's WezTerm config (colors.ansi / colors.brights).
Set Theme { "name": "pc-docs", "background": "#232528", "foreground": "#d3d7cf", "cursor": "#d3d7cf", "selection": "#555753", "black": "#2e3436", "red": "#e66666", "green": "#a2bd68", "yellow": "#f0c674", "blue": "#6485ab", "magenta": "#b294bb", "cyan": "#8abeb7", "white": "#d3d7cf", "brightBlack": "#555753", "brightRed": "#f75252", "brightGreen": "#9ad949", "brightYellow": "#ffdd55", "brightBlue": "#7baae0", "brightMagenta": "#c397d8", "brightCyan": "#70c0b1", "brightWhite": "#eeeeec" }
